# Copy to .env and adjust as needed. Every value below is the default,
# so an empty .env works fine.

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Ingestion ----
CHUNK_SIZE=700
CHUNK_OVERLAP=100
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval ----
TOP_K=5
# Minimum cosine similarity for the dense leg (BM25 is never filtered).
RETRIEVAL_THRESHOLD=0.3
# Candidates pulled per ranked list before fusion + reranking.
CANDIDATES=20

# ---- Hybrid search (dense + BM25) ----
ENABLE_HYBRID=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# ---- Multi-query expansion (uses llama3) ----
ENABLE_MULTI_QUERY=true
MULTI_QUERY_COUNT=3

# ---- Reciprocal Rank Fusion ----
RRF_K=60

# ---- Cross-encoder reranking ----
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- LLM (local Ollama) ----
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434/v1
